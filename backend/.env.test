# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Base SQLite jetable, recréée par chaque test (n'utilise pas MySQL)
DATABASE_URL="sqlite:///%kernel.project_dir%/var/test.db"

# Webhooks sortants : reçus par le client HTTP simulé (tests/Mock)
WEBHOOK_URL=https://hooks.talaria.test/talaria
WEBHOOK_SECRET=secret-de-test
WEBHOOK_AUTH_HEADER="X-Webhook-Token: jeton-de-test"
