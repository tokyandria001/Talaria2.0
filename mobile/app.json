{
  "expo": {
    "name": "Talaria",
    "slug": "talaria",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/DA_3.svg",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "talaria",
    "splash": {
      "image": "./assets/DA_3.svg",
      "resizeMode": "contain",
      "backgroundColor": "#4f203f"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.talaria.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/DA_3.svg",
        "backgroundColor": "#fcf9f1"
      },
      "edgeToEdgeEnabled": false
    },
    "web": {
      "favicon": "./assets/DA_3.svg"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f2c40899-dba8-409c-9d9e-573d0eca85ae"
      }
    },
    "owner": "toto2k01"
  }
}
