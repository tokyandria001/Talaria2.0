{
  "expo": {
    "name": "Talaria",
    "slug": "talaria",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "talaria",
    "splash": {
      "image": "./assets/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#4f203f"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.talaria.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.talaria.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fcf9f1"
      },
      "edgeToEdgeEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/DA_3.svg"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Talaria utilise votre position pour centrer la carte et afficher les lieux proches."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Talaria accède à vos photos pour votre photo de profil et les photos des lieux.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6cc7778e-0f6e-4a83-8c51-6d63e551cfc5"
      }
    },
    "owner": "toto2k01",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6cc7778e-0f6e-4a83-8c51-6d63e551cfc5"
    }
  }
}
